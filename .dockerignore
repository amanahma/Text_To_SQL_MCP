# Keep secrets, large data and local cruft out of the build context and image.

# Secrets — never copy any .env into the image.
.env
.env.*
!.env.example

# BIRD data (gitignored, ~955 MB) and anything local/large.
data/
logs/
.venv/
*.zip

# Results, transcripts and run outputs — not needed to run the server.
results/
eval/runs/
redteam_results.json

# Caches and build artifacts.
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# VCS / editor / project meta.
.git/
.gitignore
.gitattributes
.claude/
diff_logging.txt
