# Copy to .env and fill in real values. .env is gitignored - never commit it.
POSTGRES_PASSWORD=
DB_HOST=localhost
DB_PORT=5433
BIRD_DBS=california_schools,card_games,codebase_community,debit_card_specializing,european_football_2,financial,formula_1,student_club,superhero,thrombosis_prediction,toxicology
READER_USER=qg_reader
READER_PASSWORD=

# Plain control role for the second attack setting (side_effect / system_access).
# CONNECT + USAGE + SELECT only, no hardening. Created by scripts/create_plain.py,
# removed by scripts/drop_plain.py. Only needed when running that setting.
PLAIN_USER=qg_plain
PLAIN_PASSWORD=

# Executor audit log: one JSON line per execute_query call. Relative paths are
# resolved from the project root. Defaults to logs/audit.jsonl if unset.
AUDIT_LOG_PATH=logs/audit.jsonl

# Evaluation harness (eval/) only. Not needed to run the MCP server.
# EVAL_PROVIDER selects the model provider: anthropic | groq
EVAL_PROVIDER=
EVAL_MODEL=
# Only used by openai/gpt-oss models on Groq: low | medium | high (default medium)
EVAL_REASONING_EFFORT=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
